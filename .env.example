# Configuration file structure
#
# Load order: .env → .env.secrets → .env.local
# Later files override earlier ones.
#
# .env              Non-sensitive defaults (safe to commit)
# .env.secrets      Sensitive values — NEVER commit (gitignored)
# .env.local        Developer-specific overrides (gitignored)

# --- .env (non-sensitive defaults) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
EMBEDDING_PROVIDER=ollama
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# Embedding dimension is auto-detected from embedding_model_dimensions dict in settings.py
# Set DEFAULT_EMBEDDING_DIMENSION to override the fallback for unrecognized models:

QDRANT_URL=http://localhost:6333
OLLAMA_BASE_URL=http://localhost:11434
LANGFUSE_HOST=http://localhost:3000
REDIS_URL=redis://localhost:6379/0

# --- .env.secrets (sensitive, gitignored) ---
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=

# --- .env.local (developer overrides, gitignored) ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
#
# Code-specific LLM (optional, for code_example/api_lookup intents)
# CODE_LLM_PROVIDER=nvidia
# CODE_LLM_MODEL=deepseek-ai/deepseek-v4-flash

# Per-purpose LLM overrides (empty = use global LLM_PROVIDER / LLM_MODEL)
# Useful for routing different pipeline stages to different providers.
# E.g. use cheap Ollama for rewriting / groundedness, powerful OpenRouter for answer generation.
# ANSWER_LLM_PROVIDER=openrouter
# ANSWER_LLM_MODEL=openrouter/gpt-4o-mini
# REWRITE_LLM_PROVIDER=ollama
# REWRITE_LLM_MODEL=llama3.2:3b
# GROUNDEDNESS_LLM_PROVIDER=
# GROUNDEDNESS_LLM_MODEL=
# INTENT_LLM_PROVIDER=
# INTENT_LLM_MODEL=
# ENRICHMENT_LLM_PROVIDER=
# ENRICHMENT_LLM_MODEL=
# EVALUATION_LLM_PROVIDER=
# EVALUATION_LLM_MODEL=

# for local setup recommended to use the following models for each stage of the pipeline:
# Generates the final user-facing response using the retrieved context.
# Needs a balance of speed and high-fidelity text generation.
ANSWER_LLM_MODEL=phi4:mini-q8_0

# Rephrases user queries into optimized search vectors.
# Needs to be lightning-fast with strict formatting.
REWRITE_LLM_MODEL=gemma4:e4b-q4_K_M

# Checks if the generated answer is strictly supported by the context.
# Needs DeepSeek's advanced reasoning capabilities to catch hallucinations.
GROUNDEDNESS_LLM_MODEL=deepseek-r1:8b

# Classifies user intent and extracts entity metadata from incoming queries.
# Fits entirely in memory with near-zero latency.
INTENT_LLM_MODEL=phi4:mini-q4_K_M

# Expands queries or synthesizes multi-document summaries before embedding.
# Excellent at maintaining context across long text chains.
ENRICHMENT_LLM_MODEL=phi4:mini-q8_0

# Scores the overall system performance (e.g., faithfulness, relevance).
# Requires the highest logic benchmark scores to act as an effective judge.
EVALUATION_LLM_MODEL=deepseek-r1:8b
CODE_LLM_MODEL=deepseek-ai/deepseek-v4-flash


#github model suggestions
ANSWER_LLM_MODEL=openai/gpt-4o-mini
REWRITE_LLM_MODEL=microsoft/phi-3-mini-4k-instruct
GROUNDEDNESS_LLM_MODEL=microsoft/phi-3-small-8k-instruct
INTENT_LLM_MODEL=meta/llama-3.2-3b-instruct
ENRICHMENT_LLM_MODEL=openai/gpt-4o-mini
EVALUATION_LLM_MODEL=microsoft/phi-3.5-mini-instruct
CODE_LLM_MODEL=microsoft/phi-4-mini-instruct

# local ollama models suggestion
ANSWER_LLM_MODEL=llama3.1:8b
REWRITE_LLM_MODEL=llama3.2:3b
GROUNDEDNESS_LLM_MODEL=phi4-mini
INTENT_LLM_MODEL=llama3.2:3b
ENRICHMENT_LLM_MODEL=qwen2.5-coder:7b
EVALUATION_LLM_MODEL=deepseek-r1:8b
CODE_LLM_MODEL=qwen2.5-coder:7b

# nvidia models suggestion
ANSWER_LLM_MODEL=meta/llama-3.1-8b-instruct
REWRITE_LLM_MODEL=meta/llama-3.2-3b-instruct
GROUNDEDNESS_LLM_MODEL=microsoft/phi-3.5-mini-instruct
INTENT_LLM_MODEL=meta/llama-3.2-3b-instruct
ENRICHMENT_LLM_MODEL=meta/llama-3.1-8b-instruct
EVALUATION_LLM_MODEL=google/gemma-2-9b-it
CODE_LLM_MODEL=qwen/qwen2.5-coder-7b-instruct

# google gemini models suggestion
ANSWER_LLM_MODEL=gemini-2.5-flash
REWRITE_LLM_MODEL=gemini-2.5-flash-lite
GROUNDEDNESS_LLM_MODEL=gemini-2.5-flash-lite
INTENT_LLM_MODEL=gemini-2.5-flash-lite
ENRICHMENT_LLM_MODEL=gemini-2.5-flash
EVALUATION_LLM_MODEL=gemini-2.5-flash
CODE_LLM_MODEL=gemini-2.5-flash-lite

# openrouter models suggestion
ANSWER_LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
REWRITE_LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free
GROUNDEDNESS_LLM_MODEL=google/gemma-2-9b-it:free
INTENT_LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free
ENRICHMENT_LLM_MODEL=openai/gpt-oss-20b:free
EVALUATION_LLM_MODEL=google/gemma-2-9b-it:free
CODE_LLM_MODEL=qwen/qwen-2.5-coder-32b-instruct:free

