{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
"read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": "allow",    
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "make test*": "allow",
      "make docker*": "allow",
      "docker compose up *": "allow",
      "docker build *": "deny",
      "docker push *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "sudo *": "deny",
      "docker volume rm *": "deny",
      "docker volume prune *": "deny",
      "docker compose down -v*": "deny",
      "docker system prune *": "deny",
      "docker rm *": "deny",
      "docker rmi *": "deny",
      "rm -rf *": "deny"

    }
  }
}
