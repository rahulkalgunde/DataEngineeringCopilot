# Configuration file structure
#
# Load order: .env → .env.secrets → .env.local
# Later files override earlier ones.
#
# .env              Non-sensitive defaults (safe to commit)
# .env.secrets      Sensitive values — NEVER commit (gitignored)
# .env.local        Developer-specific overrides (gitignored)

# --- .env (non-sensitive defaults) ---
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
LOCAL_EMBEDDING_DIMENSION=768
OPENROUTER_EMBEDDING_DIMENSION=2048
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_DIMENSION=2048

QDRANT_URL=http://localhost:6333
OLLAMA_BASE_URL=http://localhost:11434
LANGFUSE_HOST=http://localhost:3000
REDIS_URL=redis://localhost:6379/0

# --- .env.secrets (sensitive, gitignored) ---
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# REDIS_URL=redis://:password@localhost:6379/0
# OPENROUTER_API_KEY=sk-or-...
# NVIDIA_NIM_API_KEY=nvapi-...

# --- .env.local (developer overrides, gitignored) ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
#
# Code-specific LLM (optional, for code_example/api_lookup intents)
# CODE_LLM_PROVIDER=nvidia
# CODE_LLM_MODEL=deepseek-ai/deepseek-v4-flash
