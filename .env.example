# Configuration file structure
#
# Load order: .env -> .env.secrets -> .env.local
# Later files override earlier ones.
#
# .env              Non-sensitive defaults (safe to commit)
# .env.secrets      Sensitive values -- NEVER commit (gitignored)
# .env.local        Developer-specific overrides (gitignored)

# ============================================================
# GLOBAL LLM PROVIDER / MODEL
# ============================================================
# Primary provider+model used whenever a pipeline stage has no
# per-purpose override. Defaults to local Ollama.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# Provider-specific default models. Used when a purpose sets no
# explicit model and no {provider}_{purpose}_llm_model override.
# OPENROUTER_MODEL="openrouter/free"
# GROQ_MODEL=llama-3.1-8b-instant
# CEREBRAS_MODEL=gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# NVIDIA_MODEL=
# OLLAMA_MODEL=llama3.2:3b

# ============================================================
# PER-PURPOSE LLM OVERRIDES
# ============================================================
# Each pipeline stage can route to its own provider/model.
#   * provider empty -> fall back to global LLM_PROVIDER
#   * model empty    -> use that provider's default model
#                        (or {PROVIDER}_{PURPOSE}_LLM_MODEL, see below)
#
# Model resolution priority:
#   1. {PURPOSE}_LLM_MODEL (explicit)
#   2. {provider}_{purpose}_llm_model (per-provider purpose override)
#   3. {provider}_model (provider default)
#   4. LLM_MODEL (global default)

# Generates the final user-facing answer using the retrieved context.
# Needs a balance of speed and high-fidelity text generation.
# ANSWER_LLM_PROVIDER=openrouter
# ANSWER_LLM_MODEL=openrouter/gpt-4o-mini

# Rephrases user queries into optimized search vectors.
# Needs to be lightning-fast with strict formatting.
# REWRITE_LLM_PROVIDER=groq
# REWRITE_LLM_MODEL=llama-3.1-8b-instant

# Checks whether the generated answer is strictly supported by the context.
# Needs advanced reasoning to catch hallucinations.
# GROUNDEDNESS_LLM_PROVIDER=groq
# GROUNDEDNESS_LLM_MODEL=llama-3.1-8b-instant

# Classifies user intent and extracts entity metadata from incoming queries.
# Fits entirely in memory with near-zero latency.
# INTENT_LLM_PROVIDER=groq
# INTENT_LLM_MODEL=llama-3.1-8b-instant

# Expands queries / synthesizes multi-document summaries before embedding.
# Excellent at maintaining context across long text chains.
# ENRICHMENT_LLM_PROVIDER=cerebras
# ENRICHMENT_LLM_MODEL=llama-3.1-8b

# Scores the overall system performance (e.g. faithfulness, relevance).
# Requires the highest logic benchmark scores to act as an effective judge.
# EVALUATION_LLM_PROVIDER=groq
# EVALUATION_LLM_MODEL=llama-3.1-8b-instant

# Code-example / api_lookup intents.
# CODE_LLM_PROVIDER=nvidia
# CODE_LLM_MODEL=deepseek-ai/deepseek-v4-flash

# ============================================================
# LLM FALLBACK CHAIN
# ============================================================
# Ordered providers tried after a purpose's primary provider fails.
# Primary is always tried first; the chain then walks this list
# (deduped), with Ollama as the last resort.
# nvidia is ALWAYS skipped in LLM chains (embeddings only).
# NOTE: must be a JSON array string -- comma-separated values fail
# pydantic parsing.
LLM_FALLBACK_ORDER='["openrouter","groq","cerebras","ollama"]'
# Per-attempt timeout (seconds) for non-primary fallback providers.
LLM_FALLBACK_CALL_TIMEOUT=120

# After this many consecutive Ollama failures the degraded fallback is skipped
# (fail fast) instead of stalling each request on a broken local model. A single
# success resets the counter. Default: 3.
OLLAMA_DEGRADED_MAX_CONSECUTIVE_FAILURES=3

# ============================================================
# PER-PROVIDER PURPOSE MODEL OVERRIDES
# ============================================================
# When a purpose routes to (or falls back to) a given provider,
# use this model instead of that provider's default.
# Format: {PROVIDER}_{PURPOSE}_LLM_MODEL
#   PROVIDER: openrouter | nvidia | groq | cerebras | gemini | ollama
#   PURPOSE : ANSWER | REWRITE | GROUNDEDNESS | INTENT | ENRICHMENT | EVALUATION | CODE
# All unset by default => each provider's default model is used.
# Examples:
# OPENROUTER_ANSWER_LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# GROQ_ANSWER_LLM_MODEL=llama-3.3-70b-versatile
# OLLAMA_CODE_LLM_MODEL=qwen2.5-coder:7b   # set by default in settings.py

# ============================================================
# EMBEDDINGS
# ============================================================
EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL_NAME is used when EMBEDDING_PROVIDER=ollama.
# EMBEDDING_MODEL_NAME=nomic-embed-text
# Per-provider embedding models:
# OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# Embedding dimension is auto-detected from the embedding_model_dimensions
# dict in settings.py; set DEFAULT_EMBEDDING_DIMENSION to override the
# fallback for unrecognized models.

# ============================================================
# SERVICE URLS
# ============================================================
QDRANT_URL=http://localhost:6333
OLLAMA_BASE_URL=http://localhost:11434
# Separate Ollama instances for embeddings vs LLM (defaults to OLLAMA_BASE_URL).
# EMBEDDING_OLLAMA_BASE_URL=
# LLM_OLLAMA_BASE_URL=

# Local Ollama performance controls.
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_POOL_TIMEOUT_SECONDS=5
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=32
EMBEDDING_BATCH_SIZE=128
EMBED_CONCURRENCY=1
LANGFUSE_HOST=http://localhost:3000
REDIS_URL=redis://localhost:6379/0

# ============================================================
# .env.secrets (sensitive, gitignored) -- NEVER commit
# ============================================================
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=

# ============================================================
# .env.local (developer overrides, gitignored)
# ============================================================
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# ============================================================
# PER-PROVIDER MODEL SUGGESTIONS
# ============================================================
# Pick one provider's set and map the model names to the purpose
# overrides above (ANSWER/REWRITE/GROUNDEDNESS/INTENT/ENRICHMENT/EVALUATION/CODE).

# Local Ollama (local, free, no API key):
#   ANSWER=llama3.1:8b  REWRITE=llama3.2:3b  GROUNDEDNESS=phi4-mini
#   INTENT=llama3.2:3b  ENRICHMENT=qwen2.5-coder:7b  EVALUATION=deepseek-r1:8b  CODE=qwen2.5-coder:7b

# Groq (LLM only -- fastest, cheapest):
#   all purposes=llama-3.1-8b-instant

# Cerebras (LLM only -- ultrafast inference):
#   all purposes=llama-3.1-8b

# Google Gemini (LLM + embeddings):
#   ANSWER=gemini-2.5-flash  CODE=gemini-2.5-flash  others=gemini-2.0-flash-lite

# OpenRouter:
#   ANSWER=meta-llama/llama-3.1-8b-instruct:free  REWRITE=meta-llama/llama-3.2-3b-instruct:free
#   GROUNDEDNESS=google/gemma-2-9b-it:free  INTENT=meta-llama/llama-3.2-3b-instruct:free
#   ENRICHMENT=openai/gpt-oss-20b:free  EVALUATION=google/gemma-2-9b-it:free
#   CODE=qwen/qwen-2.5-coder-32b-instruct:free

# NVIDIA:
#   ANSWER=meta/llama-3.1-8b-instruct  REWRITE=meta/llama-3.2-3b-instruct
#   GROUNDEDNESS=microsoft/phi-3.5-mini-instruct  INTENT=meta/llama-3.2-3b-instruct
#   ENRICHMENT=meta/llama-3.1-8b-instruct  EVALUATION=google/gemma-2-9b-it
#   CODE=qwen/qwen2.5-coder-7b-instruct

# GitHub Models:
#   ANSWER=openai/gpt-4o-mini  REWRITE=microsoft/phi-3-mini-4k-instruct
#   GROUNDEDNESS=microsoft/phi-3-small-8k-instruct  INTENT=meta/llama-3.2-3b-instruct
#   ENRICHMENT=openai/gpt-4o-mini  EVALUATION=microsoft/phi-3.5-mini-instruct
#   CODE=microsoft/phi-4-mini-instruct

# ============================================================
# CONTAINER INFRASTRUCTURE (docker-compose.yml)
# ============================================================
# Used by the local Docker Compose stack. Provide non-default values in
# .env for anything other than local development.
# REDIS_PASSWORD=local_secure_password_123
# POSTGRES_PASSWORD=local_secure_password_123
# LANGFUSE_PG_PASSWORD=local_secure_password_123
# CLICKHOUSE_PASSWORD=local_secure_password_123
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# LANGFUSE_ENCRYPTION_KEY=<64 hex chars>   # REQUIRED — generate with: openssl rand -hex 32
